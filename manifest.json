{
  "manifest_version": 3,
  "name": "GridX - High-Density X Dashboard",
  "version": "0.1.1",
  "description": "Turn X into a high-density, multi-column grid dashboard. Scan dozens of posts at once with vim-style keys.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "GridX - High-Density X Dashboard"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-grid": {
      "suggested_key": { "default": "Ctrl+Shift+G" },
      "description": "Toggle the GridX grid overlay"
    },
    "toggle-pause": {
      "suggested_key": { "default": "Ctrl+Shift+P" },
      "description": "Pause / resume the grid"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
